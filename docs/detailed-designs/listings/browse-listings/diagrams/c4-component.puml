@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse listings

Person(anyone, "Anyone", "Browses approved listings")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(page, "BrowsePage", "Page in rent, lazy route", "Orchestrates Browse; keeps the two switch choices and the search term in the address")
  Component(store, "BrowseStore", "Service in domain search/", "Windowed, paged store of listings and the three counts; provided at the Browse route")
  Component(client, "ListingsApi", "HTTP client in api, LISTINGS_API", "Builds the browse request and returns a typed page")
  Component(hdr, "Header", "Presentation component", "Wordmark, Messages, account control and Post; shared with Listing")
  Component(switch, "OfferSwitch", "Presentation component", "Everything, For rent, Wanted, each with its count")
  Component(kind, "KindSwitch", "Presentation component", "All, Spaces, Things")
  Component(card, "ListingCard", "Presentation component", "For rent: photo with Space or Thing, title, price, area and distance, church. Wanted: a blue panel, then member, budget, area and distance, church")
  Component(empty, "EmptyState / ErrorState", "Presentation components", "One state for every empty list, with Ask for; failure message with Try again")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "ListingsController", "ASP.NET Core controller", "Browse action, open to anyone; sends one MediatR request")
  Component(validator, "BrowseListingsQueryValidator", "FluentValidation validator", "Refuses a page size above 50")
  Component(handler, "BrowseListingsQueryHandler", "MediatR handler", "Selects approved listings within 25 km of the place, newest first, one page; counts the first switch")
  Component(entity, "Listing", "Domain entity", "Holds the offer, the kind, the area and the status")
  Component(radius, "BrowseRadius", "Domain rule", "25 km; the distance in whole kilometres")
}
ContainerDb(db, "Database", "Relational, EF Core; engine <TO SUPPLY>", "Listings and photo records")

Rel(anyone, page, "Opens, scrolls, switches")
Rel(page, hdr, "Is shown under the header that AppShell renders with")
Rel(page, switch, "Binds the first choice to")
Rel(page, kind, "Binds the second choice to")
Rel(page, card, "Renders each listing with")
Rel(page, empty, "Renders empty and failed states with")
Rel(page, store, "Opens a query and asks for more")
Rel(store, client, "Requests a page through")
Rel(client, ctrl, "GET /listings", "JSON/HTTPS")
Rel(ctrl, validator, "Sends BrowseListingsQuery", "MediatR")
Rel(validator, handler, "Passes a valid query to")
Rel(handler, entity, "Projects to ListingSummaryDto")
Rel(handler, radius, "Keeps listings within the radius; computes the distance with")
Rel(handler, db, "Reads through IAppDbContext", "EF Core")
@enduml
