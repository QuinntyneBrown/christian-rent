@startuml
title UML sequence behaviour — Apply migrations at deployment
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator or deployment" as actor
box "Backend — ChristianRent.Cli" #D1FADF
  participant "migrate command" as migrate
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "Program" as apiStart
  participant "HealthController" as health
end box
box "Backend — ChristianRent Infrastructure" #FFF4E5
  participant "AppDbContext" as ctx
  database "Database" as db
end box
actor -> migrate : Run migrate with the connection string from configuration
migrate -> ctx : Database.MigrateAsync()
ctx -> db : Apply each pending migration
alt a migration fails
  db --> ctx : Error
  ctx --> migrate : Exception
  migrate --> actor : Non-zero exit; the deployment stops and the API is not replaced
else all migrations are applied
  db --> ctx : Schema is current
  ctx --> migrate : Done
  migrate --> actor : Exit 0 (L2-034 criterion 3)
  actor -> apiStart : Start the new version of the API
  apiStart -> apiStart : Build the pipeline; apply no migration (L2-034 criterion 3)
  actor -> health : GET the health endpoint
  health --> actor : 200 once the database and file storage are reachable
end
@enduml
