@startuml
title UML sequence behaviour — Become a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person who is not a member" as actor
box "Frontend — rent application" #E0F2FE
  participant "MemberGate" as gate
  participant "JoinDialog" as dialog
  participant "HttpMembersApi" as client
  participant "Session" as session
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "MembersController" as ctrl
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "JoinCommandHandler" as handler
  participant "Member" as entity
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> gate : Try to post, message or report
gate -> session : member()
session --> gate : null
gate -> dialog : Open (draft already saved by the caller)
dialog --> actor : "Become a member", focus inside the dialog
actor -> dialog : Name, church, "I am a Christian", submit
dialog -> dialog : Validate all three (L2-017 criterion 1)
dialog -> client : join(request)
client -> ctrl : POST /api/members
ctrl -> handler : Send JoinCommand
handler -> handler : Validate name up to 60, church up to 100 (L2-017)
handler -> db : Find church, or match a new one by name and city
handler -> entity : Member.Join(...), IsVerified = false
handler -> handler : ReviewItem.ForNewMember(...) (L2-017 criterion 3)
handler -> db : Save member, church and review item
db --> handler : Committed
handler --> ctrl : MemberDto
ctrl --> client : 201 Created
client --> dialog : Member
dialog -> session : refresh()
dialog --> gate : Closed with true
gate --> actor : Back where they were, choices kept (L2-009)
@enduml
