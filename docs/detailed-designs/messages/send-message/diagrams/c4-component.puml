@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send a message

Person(sender, "Member", "Sends a message about a listing")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(page, "ListingPage", "Page in rent", "Orchestrates the message box, the draft and the send")
  Component(box, "MessageBox", "Presentation component in components", "Message text, dates for a listing for rent, confirmation")
  Component(rules, "MessageDraftRules", "Pure helper in domain", "Length and date rules applied in the browser")
  Component(drafts, "DraftStore", "Service in domain storage", "Keeps the unsent message for the return from sign-in")
  Component(client, "MessagesApi", "Contract and HTTP client in api", "Builds the send request, maps ApiError")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "MessagesController", "ASP.NET Core controller", "Sends one SendMessageCommand")
  Component(validator, "SendMessageCommandValidator", "FluentValidation", "Length and date rules, the same as the browser's")
  Component(handler, "SendMessageCommandHandler", "MediatR handler", "Own-listing, removed-listing and hourly-limit rules; stores the message")
  Component(current, "ICurrentMember", "Application port", "The signed-in member")
  Component(clock, "TimeProvider", "Application port", "The time used for the limit and the sent time")
  Component(message, "Message", "Domain entity", "Text, dates, sender, recipient, listing")
}
ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Listings, members and messages")

Rel(sender, box, "Writes a message in")
Rel(page, box, "Binds inputs and outputs of")
Rel(page, rules, "Checks the draft with")
Rel(page, drafts, "Saves and restores the draft through")
Rel(page, client, "Sends through MESSAGES_API")
Rel(client, ctrl, "POST /listings/{listingId}/messages", "JSON/HTTPS")
Rel(ctrl, handler, "Sends SendMessageCommand", "MediatR")
Rel(validator, handler, "Runs before")
Rel(handler, current, "Reads the sender from")
Rel(handler, clock, "Reads the time from")
Rel(handler, message, "Creates")
Rel(handler, db, "Reads and writes through IAppDbContext", "EF Core")
@enduml
