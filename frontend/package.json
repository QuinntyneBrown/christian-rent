{
  "name": "christian-rent-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve rent",
    "start:admin": "ng serve admin",
    "build": "ng build rent && ng build admin",
    "build:rent": "ng build rent",
    "build:admin": "ng build admin",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/unit-tests.mjs",
    "lint": "ng lint && eslint e2e scripts playwright.config.ts eslint.config.js && tsc -p e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --grep @critical",
    "e2e:sweeps": "SWEEPS=1 playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.7",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
