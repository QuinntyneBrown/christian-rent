@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Become a member

Person(person, "Person who is not a member", "Joins")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(host, "Join host", "Screen or CDK Dialog in rent, <TO SUPPLY>", "Orchestrates the join form")
  Component(form, "JoinForm", "Presentation component in components", "Name, church picked or entered, the declaration")
  Component(rules, "MemberRules", "Pure helper in domain", "Required fields and length limits")
  Component(client, "MembersApi", "Contract and HTTP client in api", "findChurches, join, leave")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(churches, "ChurchesController", "ASP.NET Core controller", "Sends FindChurchesQuery")
  Component(members, "MembersController", "ASP.NET Core controller", "Sends JoinCommand or LeaveCommand")
  Component(find, "FindChurchesQueryHandler", "MediatR handler", "One page of churches matching a term")
  Component(join, "JoinCommandHandler", "MediatR handler", "Creates the member, a new church and the review item")
  Component(validator, "JoinCommandValidator", "FluentValidation", "Name, church and declaration rules")
  Component(leave, "LeaveCommandHandler", "MediatR handler", "Takes the member's listings out of public view")
  Component(purge, "DeleteLeftMembersCommandHandler", "MediatR handler", "Deletes or makes anonymous within 30 days")
  Component(photos, "IPhotoStorage", "Application port", "Deletes stored photos")
}
ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Members, churches, review items, listings")

Rel(person, form, "Fills in")
Rel(host, form, "Binds inputs and outputs of")
Rel(host, rules, "Checks the entry with")
Rel(host, client, "Calls through MEMBERS_API")
Rel(client, churches, "GET /churches", "JSON/HTTPS")
Rel(client, members, "POST /members, DELETE /members/me", "JSON/HTTPS")
Rel(churches, find, "Sends FindChurchesQuery", "MediatR")
Rel(members, join, "Sends JoinCommand", "MediatR")
Rel(validator, join, "Runs before")
Rel(members, leave, "Sends LeaveCommand", "MediatR")
Rel(purge, photos, "Deletes photos through")
Rel(find, db, "Reads", "EF Core")
Rel(join, db, "Writes", "EF Core")
Rel(leave, db, "Writes", "EF Core")
Rel(purge, db, "Deletes or makes anonymous", "EF Core")
@enduml
