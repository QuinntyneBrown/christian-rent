@startuml
title UML sequence behaviour — Show the header
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — rent application" #E0F2FE
  participant "AppShell" as shell
  participant "Router" as router
end box
box "Frontend — components library" #E0F2FE
  participant "Header" as hdr
  participant "Wordmark" as wordmark
end box
box "Frontend — api library" #E0F2FE
  participant "MessagesApi" as messages
end box
actor -> shell : Open Browse or Listing
shell -> hdr : Render above main; the route asks for the header
hdr -> wordmark : Render inside the control named "christian.rent home"
alt viewport under 640 px
  wordmark --> actor : The mark alone (L2-023 criterion 3)
else viewport from 640 px
  wordmark --> actor : The mark and the wordmark, ".rent" in orange (L2-023 criterion 2)
end
shell -> messages : Ask how many messages the member has not read
note right of messages : The request behind the contract is designed in messages/
messages --> shell : Number unread
shell -> hdr : Bind unreadCount and initials
hdr --> actor : Messages with the number unread when above 0 (L2-036 criterion 3); initials (L2-036 criterion 4); "Post"
actor -> shell : Scroll the page
hdr --> actor : The header stays at the top (L2-036 criterion 1)
alt the member selects the wordmark
  actor -> hdr : Select "christian.rent home"
  hdr -> shell : home
  shell -> router : Navigate to Browse (L2-036 criterion 2)
else the member selects "Post"
  actor -> hdr : Select "Post"
  hdr -> shell : post
  shell -> router : Navigate to Post set to "I have" (L2-036 criterion 5)
else the member selects Messages or the account control
  actor -> hdr : Select the control
  hdr -> shell : openMessages or openAccount
  note right of shell : What each opens is <TO SUPPLY>
end
@enduml
