@startuml
title UML sequence behaviour — Complete a form by keyboard with a screen reader
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member using a keyboard\nand a screen reader" as actor
box "Frontend — rent application" #E0F2FE
  participant "AppShell" as shell
  participant "RouteFocus" as focus
  participant "PostPage" as page
  participant "CdkAnnouncer" as announcer
end box
box "Frontend — components library" #E0F2FE
  participant "FormField" as field
end box
actor -> shell : Follow a link to Post
shell -> page : Activate the route in main
shell -> focus : focusHeading()
focus --> actor : Focus on the screen's h1; the screen reader reads its name
actor -> field : Tab through the fields in screen order (L2-032 criterion 2)
field --> actor : Visible focus ring; visible label read as the field's name (L2-032 criterion 5)
actor -> page : Press Enter on the submit button
alt a field is invalid
  page -> field : Set error
  field -> field : aria-invalid="true"; aria-describedby points at the error text
  page -> field : Move focus to the first invalid field
  page -> announcer : announce(error summary, assertive)
  announcer --> actor : Error announced (L2-032 criterion 4)
  field --> actor : Error read with the field; state carried by attribute and text, not colour (L2-032 criterion 3)
else every field is valid
  page -> page : Post the listing
  page -> announcer : announce(confirmation, polite)
  announcer --> actor : Confirmation announced (L2-032 criterion 4)
  page -> focus : focusHeading()
  focus --> actor : Focus on the confirmation heading
end
opt the person asks for reduced motion
  page --> actor : The change appears with a short fade and no other movement (L2-032 criterion 6)
end
@enduml
