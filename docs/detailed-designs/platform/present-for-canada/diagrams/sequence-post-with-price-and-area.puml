@startuml
title UML sequence behaviour — Post a listing with a price in whole dollars and the member's area
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — rent application" #E0F2FE
  participant "PostPage" as page
end box
box "Frontend — domain library" #E0F2FE
  participant "ListingDraftRules" as rules
end box
box "Frontend — api library" #E0F2FE
  participant "ListingsApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — ChristianRent Application and Domain" #ECFDF3
  participant "PostListingCommandValidator" as validator
  participant "PostListingCommandHandler" as handler
end box
box "Backend — ChristianRent Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> page : Open Post
page --> actor : No area field; "Prices in CAD. Shown to members within 25 km of Langley, BC." (L2-022 criterion 7, L2-010 criterion 6)
actor -> page : Enter a title and a price in whole dollars, and submit
page -> rules : Check the draft
rules --> page : The price is a whole number
page -> client : Post the ListingDraft, which carries no area
client -> controller : HTTPS request
controller -> controller : Authenticate the signed-in member
controller -> validator : Send PostListingCommand through the validation step
alt the price has cents, sent straight to the backend
  validator --> controller : Refusal for the price field
  controller --> client : ProblemDetails, code validation_failed (L2-010 criteria 2 and 9)
  client --> page : ApiError with fieldErrors
  page --> actor : Price field says why; nothing typed is lost
else the command is valid
  validator -> handler : Pass PostListingCommand on
  handler -> db : Read the place of the member who posts
  note right of db : How a member's place is set and shown to be in Canada is <TO SUPPLY> (L2-022 criterion 5)
  db --> handler : The member's place
  handler -> db : Save the listing with that area, as waiting for review
  handler --> controller : Listing saved
  controller --> client : HTTP response
  client --> page : Posted listing
  page --> actor : Confirmation
end
@enduml
