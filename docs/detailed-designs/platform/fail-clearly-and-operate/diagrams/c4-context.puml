@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Fail clearly and operate

Person(person, "Anyone, member or admin", "Sees a loading state, a plain message with Try again, or a not-found screen")
Person(operator, "Operator", "Deploys christian.rent and watches it in production")
System(cr, "christian.rent", "Fails clearly and reports its health and its traces")
System_Ext(otel, "Telemetry backend", "Receives traces, metrics and logs over OTLP; product <TO SUPPLY>")
System_Ext(backup, "Backup", "Holds a daily copy of the database and the photos; mechanism <TO SUPPLY>")

Rel(person, cr, "Uses")
Rel(operator, cr, "Calls the health endpoint of and runs the migrate command against")
Rel(cr, otel, "Emits a trace, its duration and its outcome to", "OTLP")
Rel(cr, backup, "Is copied each day to")
Rel(operator, otel, "Finds an error by its trace id in")
@enduml
