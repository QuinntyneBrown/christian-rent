@startuml
title UML sequence behaviour — Lay a screen out for the width
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Admin" as actor
box "Frontend — rent application" #E0F2FE
  participant "AppShell" as shell
  participant "MatchMediaViewport" as viewport
end box
box "Frontend — admin library" #E0F2FE
  participant "AdminPage" as page
  participant "ReviewQueueList" as list
  participant "ReviewDetailPanel" as panel
end box
box "Frontend — components library" #E0F2FE
  participant "Foundations (breakpoint mixin)" as css
end box
actor -> shell : Open Admin at some viewport width
shell -> page : Activate the route in main
page -> css : Apply the page stylesheet
css --> page : One column under 768 px; two columns from 768 px
page -> viewport : atLeast(md)
viewport -> viewport : matchMedia("(min-width: 768px)"), listen for change
viewport --> page : Signal<boolean>
page -> list : Render the review queue
alt viewport under 768 px
  page --> actor : Only the queue is shown (L2-031 criterion 5)
else viewport from 768 px
  page -> panel : Render beside the queue with Approve, Keep and Remove
  panel --> actor : Queue and detail panel side by side (L2-031 criterion 5)
end
actor -> shell : Rotate the device or resize the window
viewport -> viewport : Media query changes
viewport --> page : Signal updates
page --> actor : Layout follows the new width; nothing is cut off, no sideways scroll (L2-031 criterion 1)
actor -> shell : Leave Admin
shell -> page : Destroy
page -> viewport : Release the effect
note right of viewport : MatchMediaViewport removes its listeners when the application is destroyed
@enduml
