@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Add photos

Person(member, "Member", "Adds photos to a listing for rent")
Person(anyone, "Anyone", "Sees photos on Browse and Listing")
System_Boundary(cr, "christian.rent") {
  Container(rent, "rent", "Angular", "The four screens: Browse, Listing, Post and Admin")
  Container(api, "ChristianRent.Api", "ASP.NET Core", "Listings, photos, search, messages, members and the review queue")
  ContainerDb(db, "Database", "Relational, EF Core; engine <TO SUPPLY>", "Listings, members, churches and photo records")
  Container(files, "File storage", "Product <TO SUPPLY>", "Photo files at each stored size")
}
Rel(member, rent, "Picks photos on Post", "HTTPS")
Rel(anyone, rent, "Opens Browse or Listing", "HTTPS")
Rel(rent, api, "Uploads one photo per request; requests a photo at a named size", "Multipart and image over HTTPS")
Rel(api, db, "Writes and reads photo records, never photo content", "EF Core")
Rel(api, files, "Stores inspected photos in; serves photos from", "IPhotoStorage")
@enduml
