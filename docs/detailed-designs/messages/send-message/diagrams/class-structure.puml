@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Send a message about a listing

class Message {
  +Guid Id
  +Guid ListingId
  +Guid SenderId
  +Guid RecipientId
  +string Text
  +DateOnly? StartDate
  +DateOnly? EndDate
  +DateTimeOffset SentAt
  +{static} Send(listing, senderId, text, startDate, endDate, now): Message
  +CanBeReadBy(memberId: Guid): bool
  +ClearText()
}
class SendMessageCommand {
  +string ListingId
  +string Text
  +DateOnly? StartDate
  +DateOnly? EndDate
}
class SendMessageCommandValidator {
  +Validate(command: SendMessageCommand): ValidationResult
}
class SendMessageCommandHandler {
  +Handle(command: SendMessageCommand): Task<SentMessageDto>
}
class MessagingLimit {
  +{static} MaxPerWindow: 20
  +{static} Window: 1 hour
  +{static} RetryAt(sentAt, now): DateTimeOffset?
}
class MessageDto <<with the inbox>> {
  +string SenderName
  +bool SenderIsVerified
  +string SenderChurchName
  +bool SenderChurchIsVerified
  +string ListingTitle
  +DateOnly? StartDate
  +DateOnly? EndDate
  +string Text
}
class MessageComposer <<Angular>> {
  +draft: Signal<MessageDraft>
  +state: Signal<MessageState>
  +open(listingId: string)
  +send(): Promise<void>
}
class MessageDraft <<TypeScript>> {
  +text: string
  +startDate: string
  +endDate: string
}
SendMessageCommandHandler ..> SendMessageCommand : handles
SendMessageCommandValidator ..> SendMessageCommand : validates
SendMessageCommandHandler ..> MessagingLimit : checks
SendMessageCommandHandler --> Message : creates
Message --> "1" Listing : about
Message --> "2" Member : sender, recipient
MessageDto ..> Message : projects
MessageComposer *-- MessageDraft
class MessageDraftStore <<TypeScript>> {
  +save(listingId, draft)
  +restore(listingId): MessageDraft | null
  +clear(listingId)
}
MessageComposer ..> MessageDraftStore : keeps the draft
@enduml
