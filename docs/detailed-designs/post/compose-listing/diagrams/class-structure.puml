title Class structure — Compose a listing

class ListingDraft <<TypeScript>> {
  +offer: 'for-rent' | 'wanted'
  +kind: 'space' | 'thing'
  +title: string
  +price: string
  +pricePeriod: 'hour' | 'day' | 'week' | 'month'
  +whenMode: 'text' | 'dates'
  +whenText: string
  +startDate: string
  +endDate: string
  +area: string
  +note: string
  +photoIds: string[]
  +clientRequestId: string
}
class DraftErrors <<TypeScript>> {
  +title?: DraftError
  +price?: DraftError
  +whenText?: DraftError
  +startDate?: DraftError
  +endDate?: DraftError
  +area?: DraftError
  +note?: DraftError
}
class ListingDraftValidator <<TypeScript>> {
  +validateDraft(draft: ListingDraft): DraftErrors
  +summaryOf(errors: DraftErrors): SummaryEntry[]
}
class PostStore <<Angular>> {
  +draft: Signal<ListingDraft>
  +errors: Signal<DraftErrors>
  +previewCard: Signal<ListingCardView>
  +setOffer(offer): void
  +setKind(kind): void
  +patch(change: Partial<ListingDraft>): void
  +check(): boolean
}
class DraftStore <<TypeScript>> {
  +save(draft: ListingDraft): void
  +restore(): ListingDraft | null
  +clear(): void
}
class MemberGate <<Angular>> {
  +requireMember(purpose): Promise<boolean>
}
PostStore *-- ListingDraft
PostStore *-- DraftErrors
PostStore ..> ListingDraftValidator : uses
PostStore ..> DraftStore : saves on change / restores / clears
PostStore ..> MemberGate : requireMember('post') on entry and before publishing
DraftStore ..> ListingDraft
@enduml
