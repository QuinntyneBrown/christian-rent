@startuml
title UML sequence behaviour — Load a screen, fail clearly and try again
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Anyone" as actor
box "Frontend — rent application" #E0F2FE
  participant "Page" as page
end box
box "Frontend — components library" #E0F2FE
  participant "Skeleton" as skeleton
  participant "ErrorState" as errorstate
end box
box "Frontend — api library" #E0F2FE
  participant "apiErrorInterceptor" as interceptor
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "UnhandledExceptionHandler" as exh
  participant "Controller" as controller
end box
box "Backend — ChristianRent Application and Domain" #ECFDF3
  participant "Handler" as handler
end box
box "Backend — ChristianRent Infrastructure" #FFF4E5
  participant "Telemetry" as telemetry
end box
actor -> page : Open a screen
page -> skeleton : LoadState is loading
skeleton --> actor : Loading state in the shape of what will arrive (L2-033 criterion 1)
page -> interceptor : Request through a contract
alt the backend cannot be reached
  interceptor --> page : ApiError, code backend_unreachable
  page -> errorstate : LoadState is failed
  errorstate --> actor : Plain message and "Try again", no technical detail (L2-033 criterion 2)
  actor -> errorstate : Select "Try again"
  errorstate -> page : retry
  page -> skeleton : LoadState is loading again
  page -> interceptor : Repeat the request
else the backend answers
  interceptor -> exh : HTTPS request
  exh -> controller : Invoke the action
  controller -> handler : Send one MediatR request
  alt an unhandled error is thrown
    handler --> exh : Exception
    exh -> telemetry : Record the exception on the request's span, with its trace id
    exh --> interceptor : 500 ProblemDetails, code unexpected_error, traceId, no stack trace (L2-033 criterion 4)
    interceptor --> page : ApiError with traceId
    page -> errorstate : LoadState is failed
    errorstate --> actor : Plain message and "Try again"
  else the handler returns
    handler --> controller : Typed result
    controller --> interceptor : HTTP response
    interceptor --> page : Typed result
    page --> actor : LoadState is loaded; the content replaces the loading state
  end
  exh -> telemetry : The span ends with route template, duration and outcome (L2-034 criterion 2)
end
@enduml
