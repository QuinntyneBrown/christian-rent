@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Verify a member and a church

Person(admin, "Admin", "Confirms members and churches")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(page, "AdminPage", "Page in admin", "Orchestrates the decision and the church confirmation")
  Component(panel, "ReviewDetailPanel", "Component in admin", "Shows the new member's name and church")
  Component(client, "ReviewQueueApi", "Contract and HTTP client in api", "decide, confirmChurch")
  Component(mark, "VerifiedMark", "Presentation component in components", "Verified, in text and an icon")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(queue, "ReviewQueueController", "ASP.NET Core controller", "Sends DecideReviewItemCommand")
  Component(churches, "ChurchesController", "ASP.NET Core controller", "Sends ConfirmChurchCommand")
  Component(decide, "DecideReviewItemCommandHandler", "MediatR handler", "Applies Approve or Remove to a new member")
  Component(confirm, "ConfirmChurchCommandHandler", "MediatR handler", "Marks a church verified")
  Component(current, "ICurrentMember", "Application port", "The signed-in member and whether they are an admin")
  Component(member, "Member", "Domain entity", "Verify(), Remove()")
  Component(church, "Church", "Domain entity", "Verify()")
  Component(read, "GetListingQueryHandler", "MediatR handler", "Reads both marks into the listing as it is shown")
}
ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Members, churches, listings, review items")

Rel(admin, panel, "Reads and decides in")
Rel(page, panel, "Binds inputs and outputs of")
Rel(page, client, "Calls through REVIEW_QUEUE_API")
Rel(client, queue, "POST /review-queue/{id}/decision", "JSON/HTTPS")
Rel(client, churches, "POST /churches/{churchId}/confirm", "JSON/HTTPS")
Rel(queue, decide, "Sends DecideReviewItemCommand", "MediatR")
Rel(churches, confirm, "Sends ConfirmChurchCommand", "MediatR")
Rel(decide, current, "Requires an admin through")
Rel(confirm, current, "Requires an admin through")
Rel(decide, member, "Verifies or removes")
Rel(confirm, church, "Verifies")
Rel(decide, db, "Persists", "EF Core")
Rel(confirm, db, "Persists", "EF Core")
Rel(read, db, "Reads Member.IsVerified and Church.IsVerified", "EF Core")
Rel(read, mark, "Supplies the two marks shown by", "ListingDetail")
@enduml
