@startuml
title UML sequence behaviour — Check health
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator or probe" as actor
box "Backend — ChristianRent.Api" #D1FADF
  participant "HealthController" as controller
end box
box "Backend — ChristianRent Application and Domain" #ECFDF3
  participant "CheckHealthQueryHandler" as handler
end box
box "Backend — ChristianRent Infrastructure" #FFF4E5
  database "Database" as db
  database "File storage" as files
end box
actor -> controller : GET the health endpoint
controller -> handler : Send CheckHealthQuery
handler -> db : IAppDbContext.CanConnectAsync, within a time limit
db --> handler : Reachable or not
handler -> files : IPhotoStorage.CanReachAsync, within a time limit
files --> handler : Reachable or not
handler --> controller : HealthReport { Alive, Database, FileStorage }
alt the database and file storage are both reachable
  controller --> actor : 200 with the report (L2-034 criterion 1)
else one of them is not reachable
  controller --> actor : 503 with the report naming which one (L2-034 criterion 1)
end
@enduml
