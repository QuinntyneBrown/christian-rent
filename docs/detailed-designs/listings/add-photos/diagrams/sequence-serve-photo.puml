@startuml
title UML sequence behaviour — Serve a photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Anyone" as actor
box "Frontend — rent application" #E0F2FE
  participant "BrowsePage or ListingPage" as page
end box
box "Frontend — api library" #E0F2FE
  participant "PhotosApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "PhotosController" as controller
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "GetPhotoQueryHandler" as handler
  participant "Photo" as entity
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
  participant "IPhotoStorage" as storage
end box
actor -> page : Open Browse or a listing
page -> client : url(photoId, card or gallery)
client --> page : /photos/id?size
page -> controller : GET /photos/id?size, from an img element\nwith its space reserved (L2-029 criterion 3)
controller -> handler : Send GetPhotoQuery
handler -> db : Load the Photo record and its listing's status
db --> handler : Photo, status; or nothing
handler -> entity : IsServedTo(memberId, isAdmin, status)
alt the listing is approved, or the caller posted it, or the caller is an admin
  entity --> handler : true
  handler -> storage : Open(photoId, size)
  storage --> handler : The stored copy at that size (L2-014 criterion 4)
  handler --> controller : PhotoContent
  controller --> page : 200 OK, the image
  page --> actor : The photo, sized to where it appears
else the listing is not approved, or no such photo
  entity --> handler : false, or no record
  handler --> controller : Not found
  controller --> page : 404 ProblemDetails, code photo_not_found\n(L2-014 criterion 5)
  page --> actor : The placeholder image
end
@enduml
