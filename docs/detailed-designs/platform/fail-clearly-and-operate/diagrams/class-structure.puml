@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Fail clearly and operate

class "LoadState<T>" as LoadState <<api type>> {
  +status: 'loading' | 'loaded' | 'failed'
  +value: T | null
  +error: ApiError | null
}

class ApiError <<api type>> {
  +code: string
  +status: number
  +traceId: string | null
}

class Skeleton <<cr-skeleton>> {
  +shape: input<'card' | 'listing' | 'row' | 'panel'>
  +count: input<number>
}

class ErrorState <<cr-error-state>> {
  +message: input<string>
  +retry: output<void>
}

class NotFoundPage <<rent page>> {
}

class UnhandledExceptionHandler <<IExceptionHandler>> {
  +TryHandleAsync(context: HttpContext, exception: Exception, ct: CancellationToken): ValueTask<bool>
}

class HealthController <<Api>> {
  +Get(): Task<IActionResult>
}

class CheckHealthQuery <<MediatR request>> {
}

class CheckHealthQueryHandler <<MediatR handler>> {
  +Handle(query: CheckHealthQuery): Task<HealthReport>
}

class HealthReport <<Application DTO>> {
  +bool Alive
  +bool Database
  +bool FileStorage
}

interface IAppDbContext <<Application port>> {
  +CanConnectAsync(ct: CancellationToken): Task<bool>
}

interface IPhotoStorage <<Application port>> {
  +CanReachAsync(ct: CancellationToken): Task<bool>
}

class PersonalDataProcessor <<BaseProcessor<Activity>>> {
  +OnEnd(activity: Activity): void
}

class MigrateCommand <<ChristianRent.Cli>> {
  +RunAsync(ct: CancellationToken): Task<int>
}

LoadState --> ApiError : carries when failed
Skeleton ..> LoadState : shown for loading
ErrorState ..> LoadState : shown for failed
UnhandledExceptionHandler ..> ApiError : its ProblemDetails becomes
HealthController ..> CheckHealthQuery : sends
CheckHealthQueryHandler ..> CheckHealthQuery : handles
CheckHealthQueryHandler --> HealthReport : returns
CheckHealthQueryHandler ..> IAppDbContext : probes
CheckHealthQueryHandler ..> IPhotoStorage : probes
MigrateCommand ..> IAppDbContext : migrates the database behind
@enduml
