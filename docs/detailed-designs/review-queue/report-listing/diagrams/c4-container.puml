@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Report a listing

Person(member, "Member", "Reports a listing")
System_Ext(signin, "Sign-in", "Mechanism <TO SUPPLY>")
System_Boundary(cr, "christian.rent") {
  Container(rent, "rent", "Angular", "Listing screen with the Report dialog")
  Container(api, "ChristianRent.Api", "ASP.NET Core", "Stores one report per member per listing and queues it")
  ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Listings, reports, review items")
}
Rel(member, rent, "Uses", "HTTPS")
Rel(rent, api, "Sends the report", "JSON/HTTPS")
Rel(api, db, "Reads the listing; writes the report and its review item", "EF Core")
Rel(api, signin, "Identifies the member through")
@enduml
