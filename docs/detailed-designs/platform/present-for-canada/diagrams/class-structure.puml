@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Present for Canada

enum PricePeriod {
  Hour
  Day
  Night
  Week
  Month
}

enum ListingOffer {
  ForRent
  Wanted
}

class Listing <<Domain entity>> {
  +int Price
  +PricePeriod PricePeriod
  +ListingOffer Offer
  +string? WhenText
  +string Area
  +DateTimeOffset PostedAt
}

interface ICanadianPlaces <<Application port>> {
  +IsPlaceInCanadaAsync(place: string): Task<bool>
}

class PostListingCommandValidator <<FluentValidation>> {
  +Validate(command: PostListingCommand): ValidationResult
}

class PostListingCommandHandler <<MediatR handler>> {
  +Handle(command: PostListingCommand): Task<Result<Guid>>
}

class ListingSummary <<api type>> {
  +offer: ListingOffer
  +price: number
  +pricePeriod: PricePeriod
  +whenText: string | null
  +area: string
  +distanceKm: number
}

class PriceWithCurrency <<domain type>> {
  +amount: string
  +unit: string
}

class "domain listings/" as fmt <<pure functions>> {
  +formatPrice(price: number, period: PricePeriod, offer: ListingOffer): string
  +formatPriceWithCurrency(price: number, period: PricePeriod, offer: ListingOffer): PriceWithCurrency
  +formatDistance(km: number): string
  +formatDate(isoDate: string): string
  +formatDay(isoDate: string): string
  +formatAgo(then: string, now: Date): string
  +formatWhen(whenText: string | null): string | null
}

class Wordmark <<cr-wordmark>> {
  +text: input<'always' | 'from-sm' | 'from-md' | 'never'>
  +tone: input<'orange' | 'ink' | 'white'>
}

class RentTitleStrategy <<TitleStrategy>> {
  +updateTitle(snapshot: RouterStateSnapshot): void
}

class ListingCard <<cr-listing-card>> {
  +title: input<string>
  +priceText: input<string>
  +whenText: input<string | null>
  +area: input<string>
  +distanceText: input<string>
}

Listing --> PricePeriod : has
Listing --> ListingOffer : has
PostListingCommandValidator ..> Listing : refuses a price with cents for
PostListingCommandHandler ..> Listing : sets Area from the member's place
ListingSummary ..> Listing : carries the unformatted values of
fmt ..> ListingSummary : formats the values of
fmt ..> PriceWithCurrency : returns
ListingCard ..> fmt : shows text produced by
@enduml
