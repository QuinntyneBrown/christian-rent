@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Report a listing

package "Frontend" {
  class ReportRequest <<type, api>> {
    +reason: ReportReason
    +note: string | null
  }
  interface ReportsApi <<contract, api>> {
    +report(listingId: string, request: ReportRequest): void
  }
  class ReportRules <<helper, domain>> {
    +check(request: ReportRequest): FieldErrors
  }
  class ReportDialog <<CDK Dialog, rent>>
  class ListingPage <<page, rent>>
}

package "Backend" {
  class ReportsController {
    +Report(listingId: Guid, body: ReportBody): Task<IActionResult>
  }
  class ReportListingCommand {
    +Guid ListingId
    +ReportReason Reason
    +string? Note
  }
  class ReportListingCommandValidator
  class ReportListingCommandHandler {
    +Handle(command: ReportListingCommand): Task
  }
  class Report {
    +Guid Id
    +Guid ListingId
    +Guid ReviewItemId
    +Guid ReporterId
    +ReportReason Reason
    +string? Note
    +DateTimeOffset CreatedAt
  }
  enum ReportReason {
    NotARealListing
    Inappropriate
    Scam
    SomethingElse
  }
  class ReviewItem {
    +Guid Id
    +ReviewItemKind Kind
    +Guid? ListingId
    +DateTimeOffset CreatedAt
    +DateTimeOffset? DecidedAt
  }
  class Listing {
    +Guid Id
    +ListingStatus Status
  }
  class Member {
    +Guid Id
  }
  interface ICurrentMember {
    +Guid MemberId
  }
}

ListingPage ..> ReportDialog : opens
ReportDialog ..> ReportRules : checks with
ReportDialog ..> ReportsApi : sends through
ReportsApi ..> ReportRequest : takes
ReportsController ..> ReportListingCommand : sends
ReportListingCommandValidator ..> ReportListingCommand : validates
ReportListingCommandHandler ..> ReportListingCommand : handles
ReportListingCommandHandler ..> ICurrentMember : reads reporter
ReportListingCommandHandler --> Report : creates
ReportListingCommandHandler --> ReviewItem : finds open, or creates
Report "*" --> "1" Listing : about
Report "*" --> "1" Member : reporter
Report --> ReportReason : has
Report "1..*" --> "1" ReviewItem : open reports on one listing
ReviewItem "*" --> "1" Listing : reported listing
@enduml
