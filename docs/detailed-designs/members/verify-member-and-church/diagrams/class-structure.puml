@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Verify a member and a church

class Member {
  +Guid Id
  +string Name
  +Guid ChurchId
  +bool IsVerified
  +DateTimeOffset? RemovedAt
  +Verify(): void
  +Remove(at: DateTimeOffset): void
}
class Church {
  +Guid Id
  +string Name
  +string City
  +bool IsVerified
  +Verify(): void
}
class Listing {
  +Guid Id
  +Guid MemberId
  +ListingStatus Status
  +Remove(): void
}
enum ListingStatus {
  WaitingForReview
  Approved
  Removed
}
class ReviewItem {
  +Guid Id
  +ReviewItemKind Kind
  +Guid? MemberId
}
class DecideReviewItemCommand {
  +Guid ReviewItemId
  +ReviewOutcome Outcome
}
class DecideReviewItemCommandHandler {
  +Handle(command: DecideReviewItemCommand): Task
}
class ConfirmChurchCommand {
  +Guid ChurchId
}
class RemoveMemberCommand {
  +Guid MemberId
}
class RemoveMemberCommandHandler {
  +Handle(command: RemoveMemberCommand): Task
}
class ConfirmChurchCommandHandler {
  +Handle(command: ConfirmChurchCommand): Task
}
enum ReviewOutcome {
  Approved
  Kept
  Removed
}
interface ICurrentMember {
  +Guid MemberId
  +bool IsAdmin
}
class ListingDetail <<type, api>> {
  +memberName: string
  +memberVerified: boolean
  +churchName: string
  +churchVerified: boolean
}
class VerifiedMark <<component, components>>

DecideReviewItemCommandHandler ..> DecideReviewItemCommand : handles
DecideReviewItemCommandHandler ..> ICurrentMember : requires admin
DecideReviewItemCommandHandler --> ReviewItem : loads
DecideReviewItemCommandHandler --> Member : verifies / removes
DecideReviewItemCommandHandler --> Listing : removes a removed member's
RemoveMemberCommandHandler ..> RemoveMemberCommand : handles
RemoveMemberCommandHandler ..> ICurrentMember : requires admin
RemoveMemberCommandHandler --> Member : removes
RemoveMemberCommandHandler --> Listing : removes the member's
ConfirmChurchCommandHandler ..> ConfirmChurchCommand : handles
ConfirmChurchCommandHandler ..> ICurrentMember : requires admin
ConfirmChurchCommandHandler --> Church : verifies
DecideReviewItemCommand --> ReviewOutcome : has
ReviewItem "0..1" --> "1" Member : new member
Member "*" --> "1" Church : belongs to
Listing "*" --> "1" Member : posted by
Listing --> ListingStatus : has
ListingDetail ..> Member : memberVerified read from
ListingDetail ..> Church : churchVerified read from
VerifiedMark ..> ListingDetail : shown for
@enduml
