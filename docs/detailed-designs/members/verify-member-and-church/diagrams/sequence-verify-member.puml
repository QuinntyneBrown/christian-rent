@startuml
title UML sequence behaviour — Approve or remove a new member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Admin" as actor
box "Frontend — admin library" #E0F2FE
  participant "AdminPage" as page
  participant "ReviewDetailPanel" as panel
end box
box "Frontend — api library" #E0F2FE
  participant "ReviewQueueApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "ReviewQueueController" as controller
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "DecideReviewItemCommandHandler" as handler
  participant "Member" as member
  participant "Listing" as listing
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> panel : Select Approve or Remove on a new member
panel -> page : decide(item, outcome)
page -> client : decide(itemId, outcome)
client -> controller : POST /review-queue/{id}/decision
controller -> controller : Authenticate and apply the admin policy
alt the caller is not an admin (L2-018 criterion 5)
  controller --> client : 401 or 403, nothing changed
else the caller is an admin
  controller -> handler : Send DecideReviewItemCommand
  handler -> db : Load the review item, the member and the member's listings
  db --> handler : Current state
  alt Approve (L2-018 criterion 1)
    handler -> member : Verify()
    member --> handler : IsVerified = true
  else Remove (L2-018 criterion 4)
    handler -> member : Remove(now)
    member --> handler : RemovedAt set; the member can no longer sign in, post or message
    handler -> listing : Remove() on each of the member's listings
    listing --> handler : Status = Removed, no longer public
  end
  handler -> db : Save in one unit of work
  db --> handler : Commit result
  handler --> controller : Decided
  controller --> client : 200
end
client --> page : Result, or ApiError
page --> actor : The new member leaves the queue
note over db
  No listing is rewritten on Approve: each listing reads Member.IsVerified
  when it is shown, so the mark appears on all the member's listings.
end note
@enduml
