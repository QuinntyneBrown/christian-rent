# The static host of `admin` (ADR 0028). The API runs beside it in the same replica, on 5080.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    absolute_redirect off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Admin proxies /api/admin/ only, because Admin calls nothing else (ADR 0029). The platform's
    # ingress appends the caller's address to X-Forwarded-For and sets the scheme, so both pass
    # through unchanged; the API trusts them from this loopback address only.
    location /api/admin/ {
        proxy_pass http://127.0.0.1:5080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 404;
    }

    # Where "Back to site", "View on site" and "Go to christian.rent" lead: the deployment sets
    # SITE_URL, so the address changes without a rebuild.
    location = /config.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache" always;
        default_type application/json;
        return 200 '{ "siteUrl": "${SITE_URL}" }';
    }

    # Files whose name holds a hash of their content never change.
    location ~ "-[A-Za-z0-9_-]{8}\.(js|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Anything that is not a file is a screen: the SPA fallback. index.html and the files with
    # no hash in their name are checked with the server every time.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
