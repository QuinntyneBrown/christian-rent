@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Decide a review item

class DecideReviewItemCommand {
  +Guid ReviewItemId
  +ReviewOutcome Outcome
}
class DecideReviewItemCommandValidator
class DecideReviewItemCommandHandler {
  +Handle(command: DecideReviewItemCommand): Task
}
class ReviewItem {
  +Guid Id
  +ReviewItemKind Kind
  +Guid? ListingId
  +Guid? ReportId
  +Guid? MemberId
  +DateTimeOffset CreatedAt
  +DateTimeOffset? DecidedAt
  +Allows(outcome: ReviewOutcome): bool
  +Decide(outcome: ReviewOutcome, adminId: Guid, at: DateTimeOffset): ReviewDecision
}
class ReviewDecision {
  +Guid Id
  +Guid ReviewItemId
  +Guid AdminId
  +ReviewOutcome Outcome
  +DateTimeOffset DecidedAt
}
enum ReviewItemKind {
  NewListing
  Report
  NewMember
}
enum ReviewOutcome {
  Approved
  Kept
  Removed
}
class Listing {
  +Guid Id
  +Guid MemberId
  +ListingStatus Status
  +Approve(): void
  +Remove(): void
}
enum ListingStatus {
  WaitingForReview
  Approved
  Removed
}
class Member {
  +Guid Id
  +bool IsVerified
  +Verify(): void
  +Remove(at: DateTimeOffset): void
}
class Report {
  +Guid Id
  +Guid ListingId
}
interface ICurrentMember {
  +Guid MemberId
  +bool IsAdmin
}
interface ReviewQueueApi <<contract, api>> {
  +decide(itemId: string, outcome: ReviewOutcome): void
}
class ConfirmRemoveDialog <<CDK Dialog, admin>>
class ReviewDetailPanel <<component, admin>> {
  +item: ReviewItemDetail | null
  +busy: boolean
  +decide: ReviewOutcome
}

ReviewDetailPanel ..> ReviewQueueApi : decision sent through
ReviewDetailPanel ..> ConfirmRemoveDialog : Remove confirmed in
DecideReviewItemCommandValidator ..> DecideReviewItemCommand : validates
DecideReviewItemCommandHandler ..> DecideReviewItemCommand : handles
DecideReviewItemCommandHandler ..> ICurrentMember : reads admin
DecideReviewItemCommandHandler --> ReviewItem : loads / decides
DecideReviewItemCommandHandler --> Listing : approves / removes
DecideReviewItemCommandHandler --> Member : verifies / removes
ReviewItem "1" *-- "0..1" ReviewDecision : decided by
ReviewItem --> ReviewItemKind : has
ReviewDecision --> ReviewOutcome : has
DecideReviewItemCommand --> ReviewOutcome : has
ReviewItem "0..1" --> "0..1" Listing : new listing
ReviewItem "0..1" --> "0..1" Report : report
ReviewItem "0..1" --> "0..1" Member : new member
Report "*" --> "1" Listing : about
Listing --> ListingStatus : has
@enduml
