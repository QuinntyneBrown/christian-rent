@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show every screen to everyone

Person(person, "Anyone, member or admin", "Touch, keyboard or screen reader")
Container_Boundary(rent, "rent and its libraries") {
  Component(shell, "AppShell", "Angular component, rent", "Skip link, the header on Browse and Listing, the one main landmark and the router outlet")
  Component(hdr, "Header", "Presentation component, components", "Sticky header: wordmark, Messages with the number unread, the account control with initials, Post")
  Component(msgApi, "MessagesApi", "Contract and token, api", "Gives the number of messages a member has not read")
  Component(focus, "RouteFocus", "Service, rent", "Moves focus to the new screen's heading after navigation")
  Component(pages, "BrowsePage, ListingPage, PostPage, AdminPage", "Angular pages", "Each lays itself out with the breakpoint mixin")
  Component(viewportImpl, "MatchMediaViewport", "Service, rent", "Implements Viewport with matchMedia; releases its listeners")
  Component(announcerImpl, "CdkAnnouncer", "Service, rent", "Implements Announcer with the CDK LiveAnnouncer")
  Component(contracts, "Viewport, Announcer", "Contracts and tokens, api", "VIEWPORT and ANNOUNCER")
  Component(foundations, "Foundations", "SCSS partials, components", "Breakpoints 640, 768, 1024, 1280 px; tokens by role; focus ring; 44 px target; page width 1152 px; no motion under reduced motion")
  Component(field, "FormField", "Presentation component, components", "Visible label; error tied to the control")
  Component(blocks, "Presentation components", "components", "States as text or ARIA attributes, styled through the attribute")
  Component(dialog, "CDK Dialog", "Angular CDK", "Traps and restores focus for ReportDialog and ConfirmRemoveDialog")
}
Rel(person, shell, "Uses")
Rel(shell, pages, "Hosts in main")
Rel(shell, hdr, "Shows above main on Browse and Listing")
Rel(shell, msgApi, "Reads the number unread through")
Rel(hdr, foundations, "Reads tokens and mixins from")
Rel(shell, focus, "Is given focus targets by")
Rel(pages, foundations, "Use the breakpoint mixin of")
Rel(pages, contracts, "Inject VIEWPORT and ANNOUNCER")
Rel(viewportImpl, contracts, "Implements Viewport")
Rel(announcerImpl, contracts, "Implements Announcer")
Rel(pages, field, "Compose forms from")
Rel(pages, blocks, "Compose screens from")
Rel(blocks, foundations, "Read tokens and mixins from")
Rel(pages, dialog, "Open dialogs through")
@enduml
