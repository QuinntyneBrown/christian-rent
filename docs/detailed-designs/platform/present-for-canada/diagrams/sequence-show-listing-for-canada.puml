@startuml
title UML sequence behaviour — Show a listing presented for Canada
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Anyone" as actor
box "Frontend — rent application" #E0F2FE
  participant "AppShell" as shell
  participant "BrowsePage" as page
end box
box "Frontend — components library" #E0F2FE
  participant "Wordmark" as wordmark
  participant "ListingCard" as card
end box
box "Frontend — domain library" #E0F2FE
  participant "formatPrice / formatDistance / formatWhen" as fmt
end box
box "Frontend — api library" #E0F2FE
  participant "ListingsApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — ChristianRent Application and Domain" #ECFDF3
  participant "BrowseListingsQueryHandler" as handler
end box
box "Backend — ChristianRent Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> shell : Open christian.rent
shell -> wordmark : Render in the header
alt viewport under 640 px
  wordmark --> actor : The mark alone, named "christian.rent home" (L2-023 criterion 3)
else viewport from 640 px
  wordmark --> actor : The mark and "christian.rent" in lowercase, ".rent" in orange (L2-023 criteria 1 and 2)
end
shell -> page : Activate Browse
page -> client : Request a page of listings
client -> controller : HTTPS request
controller -> handler : Send BrowseListingsQuery
handler -> db : Read approved listings near the place
db --> handler : Price in whole CAD, PricePeriod, WhenText, Area
handler --> controller : Page of ListingSummary, values unformatted, each with its distance
controller --> client : JSON: whole amount, period, distance in km
client --> page : Page<ListingSummary>
loop each listing
  page -> fmt : formatPrice(price, pricePeriod, offer)
  alt a listing for rent with a price of 0
    fmt --> page : "Free" (L2-010 criterion 2)
  else a wanted listing
    fmt --> page : "Up to $120/day" (L2-010 criterion 4)
  else
    fmt --> page : "$25/day", whole dollars (L2-022 criterion 1)
  end
  page -> fmt : formatDistance(distanceKm)
  fmt --> page : "5 km" (L2-022 criterion 2)
  page -> fmt : formatWhen(whenText)
  fmt --> page : The member's free text, or null when empty
  page -> card : Bind priceText, distanceText, whenText, area
end
card --> actor : Cards with CAD prices, areas with distances in km, and Canadian spelling (L2-022 criterion 4)
@enduml
