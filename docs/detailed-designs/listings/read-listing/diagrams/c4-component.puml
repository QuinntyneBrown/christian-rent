@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Read a listing

Person(anyone, "Anyone", "Reads one listing")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(page, "ListingPage", "Page in rent, lazy route", "Loads one listing by the id in the address; shows it or the not-found state")
  Component(client, "ListingsApi", "HTTP client in api, LISTINGS_API", "Requests one listing and returns ListingDetail or ApiError")
  Component(hdr, "Header", "Presentation component", "Wordmark, Messages, account control and Post; shared with Browse")
  Component(gallery, "PhotoGallery", "Presentation component", "Photos at 16:10, reached by touch and keyboard; each has a text alternative")
  Component(mark, "VerifiedMark", "Presentation component", "The word Verified as text, with an icon")
  Component(format, "formatPrice / formatDistance", "Helpers in domain listings/", "Write $25 and CAD / day, Free and 5 km")
  Component(notfound, "NotFoundPage", "Page in rent", "The not-found state, with a way back to Browse")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "ListingsController", "ASP.NET Core controller", "Get action, open to anyone; sends one MediatR request")
  Component(handler, "GetListingQueryHandler", "MediatR handler", "Decides whether the caller may see the listing; projects ListingDetailDto with the distance from the place")
  Component(current, "ICurrentMember", "Application port", "The signed-in member, if any, and whether they are an admin")
  Component(entity, "Listing", "Domain entity", "IsVisibleTo(memberId, isAdmin)")
}
ContainerDb(db, "Database", "Relational, EF Core; engine <TO SUPPLY>", "Listings, photo records, members and churches")

Rel(anyone, page, "Opens /listings/id")
Rel(page, client, "get(id, place)")
Rel(page, hdr, "Is shown under the header that AppShell renders with")
Rel(page, gallery, "Renders photos with")
Rel(page, mark, "Marks a verified member and a verified church with")
Rel(page, format, "Formats price and distance with")
Rel(page, notfound, "Renders listing_not_found with")
Rel(client, ctrl, "GET /listings/id, with the place", "JSON/HTTPS")
Rel(ctrl, handler, "Sends GetListingQuery", "MediatR")
Rel(handler, current, "Asks who is calling")
Rel(handler, entity, "Asks IsVisibleTo")
Rel(handler, db, "Reads through IAppDbContext", "EF Core")
@enduml
