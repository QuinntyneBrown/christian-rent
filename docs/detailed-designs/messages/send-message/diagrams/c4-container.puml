@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send a message

Person(sender, "Member", "Sends a message about a listing")
System_Ext(signin, "Sign-in", "Identifies the member; mechanism <TO SUPPLY>")
System_Boundary(cr, "christian.rent") {
  Container(rent, "rent", "Angular", "Listing screen with the message box")
  Container(api, "ChristianRent.Api", "ASP.NET Core", "Decides whether the message may be sent and stores it")
  ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Listings, members and messages")
}
Rel(sender, rent, "Uses", "HTTPS")
Rel(rent, api, "Sends the message", "JSON/HTTPS")
Rel(api, db, "Reads the listing, counts and writes messages", "EF Core")
Rel(api, signin, "Identifies the signed-in member through")
@enduml
