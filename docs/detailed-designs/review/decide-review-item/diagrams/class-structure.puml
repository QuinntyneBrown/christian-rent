@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Decide a review item

enum ReviewDecision {
  Approve
  Keep
  Remove
}
enum ReviewItemKind {
  NewListing
  Report
  NewMember
}
class ReviewItem {
  +Guid Id
  +ReviewItemKind Kind
  +Guid SubjectId
  +ReviewDecision? Decision
  +Guid? DecidedBy
  +DateTimeOffset? DecidedAt
  +int Version
  {static} +AllowedDecisions(kind): ReviewDecision[]
  +Decide(decision, adminId, now): void
}
class DecideReviewItemCommand {
  +string Id
  +string? Decision
  +int Version
}
class DecidedDto {
  +IReadOnlyList<Guid> ClosedItemIds
}
class ReviewItemDecidedException <<Application>> {
  +string Decision
  +DateTimeOffset DecidedAt
  +bool DecidedByYou
}
class DecideReviewItemCommandHandler {
  +Handle(command: DecideReviewItemCommand): Task<DecidedDto>
}
class AlreadyDecidedException {
  +ReviewDecision Decision
  +DateTimeOffset DecidedAt
  +Guid DecidedBy
}
class ListingRemovalNotice {
  +Guid Id
  +Guid MemberId
  +Guid ListingId
  +DateTimeOffset CreatedAt
}
class RecordedMemberNotifier
class Listing {
  +ListingStatus Status
  +DateTimeOffset? ApprovedAt
  +Approve(now): void
  +Remove(): void
}
class Report {
  +ReportStatus Status
  +Close(): void
}
class Member {
  +Verify(): void
  +Remove(): void
}
interface IMemberNotifier {
  +ListingRemovedAsync(memberId: Guid, listingId: Guid): Task
}
class GetReviewArrivalsQuery {
  +string? Since
}
class ReviewQueueStore <<Angular>> {
  +decide(decision): Promise<DecisionOutcome>
  +goToNext(): void
}
class ToastQueue <<Angular>> {
  +toasts: Signal<ToastView[]>
  +push(request: ToastRequest): void
  +dismiss(id: number): void
  +dismissKey(key: string): void
  +hold(id: number, by, on: boolean): void
}
ReviewItem --> ReviewItemKind
ReviewItem --> ReviewDecision
ReviewItem ..> AlreadyDecidedException : raises
DecideReviewItemCommandHandler ..> DecideReviewItemCommand : handles
DecideReviewItemCommandHandler ..> DecidedDto : answers
DecideReviewItemCommandHandler ..> ReviewItemDecidedException : 409 already_decided
DecideReviewItemCommandHandler --> ReviewItem : decides
DecideReviewItemCommandHandler --> Listing : approves / removes
DecideReviewItemCommandHandler --> Report : closes
DecideReviewItemCommandHandler --> Member : verifies / removes
DecideReviewItemCommandHandler ..> IMemberNotifier
RecordedMemberNotifier ..|> IMemberNotifier
RecordedMemberNotifier --> ListingRemovalNotice : records
ReviewQueueStore --> ToastQueue : pushes
@enduml
