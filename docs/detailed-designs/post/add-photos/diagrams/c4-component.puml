@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Add photos to a listing

Container_Boundary(spa, "rent application (Angular workspace)") {
  Component(picker, "cr-photo-picker", "components library", "Thumbnails, Add, Remove, count")
  Component(uploads, "PhotoUploads", "Route-scoped service", "Uploads, aborts and revokes object URLs")
  Component(store, "PostStore", "Route-scoped signal store", "Ordered draft photos")
  Component(client, "HttpPhotosApi", "api library, PHOTOS_API", "Typed HTTP client")
}
Container_Boundary(api, "ChristianRent backend") {
  Component(ctrl, "PhotosController", "ASP.NET Core controller", "POST, DELETE and GET /api/photos")
  Component(up, "UploadPhotoCommandHandler", "MediatR handler", "Inspects, processes and stores")
  Component(get, "GetPhotoQueryHandler", "MediatR handler", "Authorizes and streams a rendition")
  Component(rules, "PhotoRules", "Domain rules", "Type, size and dimension limits")
  Component(insp, "IPhotoInspector, IPhotoProcessor", "Infrastructure services", "Sniffs content, strips metadata, resizes")
  Component(store2, "IPhotoStorage", "Infrastructure service", "File storage access")
}
ContainerDb(db, "Database", "EF Core; engine <TO SUPPLY>", "Persistent state")
ContainerDb(files, "File storage", "<TO SUPPLY>", "Photo renditions")
Rel(picker, uploads, "add(files) via PostPage")
Rel(uploads, store, "Updates draft photos")
Rel(uploads, client, "upload(file, signal)")
Rel(client, ctrl, "POST /api/photos", "multipart/HTTPS")
Rel(ctrl, up, "Sends UploadPhotoCommand")
Rel(ctrl, get, "Sends GetPhotoQuery")
Rel(up, insp, "Inspect, Process")
Rel(up, rules, "Check(facts, length)")
Rel(up, store2, "SaveAsync")
Rel(get, store2, "OpenReadAsync")
Rel(store2, files, "Reads and writes")
Rel(up, db, "Saves Photo row", "IAppDbContext")
Rel(get, db, "Reads Photo and listing", "IAppDbContext")
@enduml
