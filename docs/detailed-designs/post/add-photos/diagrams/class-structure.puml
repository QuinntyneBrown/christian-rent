@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Add photos to a listing

class Photo {
  +Guid Id
  +Guid OwnerId
  +Guid? ListingId
  +int Width
  +int Height
  +DateTimeOffset UploadedAt
  +AttachTo(listingId: Guid): void
}
class PhotoFacts {
  +PhotoFormat Format
  +int Width
  +int Height
}
enum PhotoFormat {
  Jpeg
  Png
  WebP
  Other
}
class PhotoRules {
  +{static} MaxBytes: 10 MB
  +{static} MinWidth: 400
  +{static} MinHeight: 300
  +{static} MaxSide: 8000
  +{static} MaxPerListing: 6
  +{static} KeepUnattached: 24 h
  +{static} Check(length: long, facts: PhotoFacts?): string?
}
interface IPhotoInspector {
  +Inspect(content: Stream): PhotoFacts?
}
interface IPhotoProcessor {
  +Process(content: Stream): IReadOnlyList<Rendition>
}
interface IPhotoStorage {
  +SaveAsync(key: string, content: Stream): Task
  +OpenReadAsync(key: string): Task<Stream?>
  +DeleteAsync(key: string): Task
  +IsReachableAsync(): Task<bool>
}
class ImageSharpPhotoInspector
class ImageSharpPhotoProcessor
class UploadPhotoCommandHandler {
  +Handle(command: UploadPhotoCommand): Task<PhotoRefDto>
}
class DeletePhotoCommandHandler {
  +Handle(command: DeletePhotoCommand): Task
}
class PurgeUnattachedPhotosCommandHandler {
  +Handle(command: PurgeUnattachedPhotosCommand): Task<int>
}
class GetPhotoQueryHandler {
  +Handle(query: GetPhotoQuery): Task<PhotoFile>
}
class PhotoUploads <<Angular>> {
  +uploading: Signal<UploadingPhoto[]>
  +add(file: File): void
  +remove(position: number): void
  -controllers: Map<string, AbortController>
  -objectUrls: Map<string, string>
}
UploadPhotoCommandHandler ..> IPhotoInspector
UploadPhotoCommandHandler ..> IPhotoProcessor
UploadPhotoCommandHandler ..> IPhotoStorage
UploadPhotoCommandHandler ..> PhotoRules
UploadPhotoCommandHandler --> Photo : creates
DeletePhotoCommandHandler --> Photo : deletes own unattached
DeletePhotoCommandHandler ..> IPhotoStorage
PurgeUnattachedPhotosCommandHandler --> Photo : deletes after 24 h
PurgeUnattachedPhotosCommandHandler ..> IPhotoStorage
GetPhotoQueryHandler --> Photo : loads
GetPhotoQueryHandler ..> IPhotoStorage
ImageSharpPhotoInspector ..|> IPhotoInspector
ImageSharpPhotoProcessor ..|> IPhotoProcessor
IPhotoInspector ..> PhotoFacts
PhotoFacts --> PhotoFormat
PhotoRules ..> PhotoFacts
@enduml
