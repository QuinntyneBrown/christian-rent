@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Present for Canada

Container_Boundary(rent, "rent and its libraries") {
  Component(places3, "Header, Post's top bar, Admin's navigation", "Angular components", "The three places a screen shows the wordmark or the mark")
  Component(title, "RentTitleStrategy", "TitleStrategy, rent", "Writes every document title with the lowercase name")
  Component(wordmark, "Wordmark", "Presentation component, components", "Draws the mark and christian.rent in lowercase with .rent in orange; the mark alone under a width")
  Component(pages, "BrowsePage, ListingPage, PostPage, AdminPage", "Angular pages", "Call the formatters and pass text on; PostPage says Prices in CAD.")
  Component(card, "ListingCard", "Presentation component, components", "Shows a price, an area with its distance and when as text it is given")
  Component(fmt, "formatPrice, formatPriceWithCurrency, formatDistance, formatDate, formatDay, formatAgo, formatWhen", "Pure functions, domain listings/", "Turn an amount, a period, a distance, a date and a time into the text Canada reads")
  Component(listingsApi, "ListingsApi", "HTTP client, api", "Carries whole amounts, periods, distances in km and ISO dates")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "ListingsController", "ASP.NET Core controller", "Sends one MediatR request per action")
  Component(validator, "PostListingCommandValidator", "FluentValidation validator, Application", "Refuses a price with cents")
  Component(handler, "PostListingCommandHandler", "MediatR handler, Application", "Gives the listing the area of its member's place")
  Component(places, "ICanadianPlaces", "Port, Application", "Says whether a place is in Canada; caller and implementation <TO SUPPLY>")
  Component(listing, "Listing", "Domain entity", "Holds Price in whole CAD, PricePeriod, WhenText, Area and PostedAt")
}
Rel(places3, wordmark, "Place")
Rel(pages, title, "Are titled by")
Rel(pages, fmt, "Call")
Rel(pages, card, "Bind formatted text to")
Rel(pages, listingsApi, "Read and post listings through")
Rel(listingsApi, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, validator, "Sends PostListingCommand, validated by")
Rel(validator, handler, "Passes a valid command to")
Rel(handler, listing, "Sets the area of")
@enduml
