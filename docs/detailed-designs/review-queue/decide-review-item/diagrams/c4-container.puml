@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Decide a review item

Person(admin, "Admin", "Decides each item of the review queue")
System_Ext(signin, "Sign-in", "Mechanism <TO SUPPLY>")
System_Boundary(cr, "christian.rent") {
  Container(rent, "rent", "Angular", "Admin's detail panel with Approve, Keep and Remove")
  Container(api, "ChristianRent.Api", "ASP.NET Core", "Applies one decision per item and records it")
  ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Review items, decisions, listings, members")
}
Rel(admin, rent, "Uses Admin", "HTTPS")
Rel(rent, api, "Sends the decision", "JSON/HTTPS")
Rel(api, db, "Reads and writes in one unit of work", "EF Core")
Rel(api, signin, "Identifies the admin through")
@enduml
