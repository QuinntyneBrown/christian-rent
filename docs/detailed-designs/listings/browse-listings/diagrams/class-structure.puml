@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Browse listings

package "Frontend — api library" {
  enum ListingOffer {
    forRent
    wanted
  }
  enum ListingKind {
    space
    thing
  }
  class ListingSummary {
    +id: string
    +offer: ListingOffer
    +kind: ListingKind
    +title: string
    +price: Price
    +when: string | null
    +area: string
    +distanceKm: number
    +churchName: string
    +postedByName: string | null
    +photo: PhotoRef | null
  }
  class OfferCounts {
    +everything: number
    +forRent: number
    +wanted: number
  }
  class BrowseResult {
    +page: Page<ListingSummary>
    +counts: OfferCounts | null
  }
  class "Page<T>" as Page {
    +items: T[]
    +nextCursor: string | null
  }
  interface ListingsApi {
    +browse(query: SearchQuery, cursor: string | null, signal: AbortSignal): Promise<BrowseResult>
  }
  class ApiError {
    +code: string
  }
}
package "Frontend — domain library" {
  class SearchQuery {
    +term: string
    +offer: ListingOffer | null
    +kind: ListingKind | null
    +place: Place
  }
  class Place {
    +name: string
  }
  class BrowseStore {
    +listings: Signal<ListingSummary[]>
    +counts: Signal<OfferCounts | null>
    +status: Signal<BrowseStatus>
    +hasMore: Signal<boolean>
    +open(query: SearchQuery): void
    +loadMore(): void
    +restoreEarlier(): void
    +retry(): void
  }
  enum BrowseStatus {
    loading
    loaded
    loadingMore
    failed
  }
}
package "Frontend — rent application" {
  class BrowsePage {
    +query: Signal<SearchQuery>
    +selectOffer(offer: ListingOffer | null): void
    +selectKind(kind: ListingKind | null): void
    +reachEnd(): void
  }
}
package "Backend — ChristianRent.Application" {
  class BrowseListingsQuery {
    +ListingOffer? Offer
    +ListingKind? Kind
    +string? Term
    +PlaceRef Place
    +string? Cursor
    +int PageSize
  }
  class BrowseListingsQueryValidator {
    +Validate(query: BrowseListingsQuery): ValidationResult
  }
  class BrowseListingsQueryHandler {
    +Handle(query: BrowseListingsQuery): Task<BrowseResultDto>
  }
  class ListingSummaryDto {
    +Guid Id
    +ListingOffer Offer
    +ListingKind Kind
    +string Title
    +PriceDto Price
    +string? When
    +string Area
    +int DistanceKm
    +string ChurchName
    +string? PostedByName
    +PhotoRefDto? Photo
  }
  class BrowseResultDto {
    +PageDto<ListingSummaryDto> Page
    +OfferCountsDto? Counts
  }
  interface IAppDbContext {
    +Listings: DbSet<Listing>
  }
}
package "Backend — ChristianRent.Domain" {
  class Listing {
    +Guid Id
    +ListingOffer Offer
    +ListingKind Kind
    +ListingStatus Status
    +string Title
    +string Area
    +string? When
  }
  class BrowseRadius {
    +{static} int Km = 25
    +{static} DistanceKm(place: PlaceRef, area: string): int
    +{static} IsWithin(place: PlaceRef, area: string): bool
  }
  enum ListingStatus {
    WaitingForReview
    Approved
    Removed
  }
}
BrowsePage --> BrowseStore : provides and reads
BrowsePage ..> SearchQuery : builds from the address
BrowseStore ..> ListingsApi : requests pages
BrowseStore ..> SearchQuery
BrowseStore --> BrowseStatus : has
BrowseStore o-- "0..*" ListingSummary : windowed buffer
ListingsApi ..> BrowseResult : returns
BrowseResult *-- Page
BrowseResult *-- OfferCounts
SearchQuery --> Place : is centred on
BrowseStore ..> OfferCounts : holds
ListingsApi ..> ApiError : refuses with
Page o-- ListingSummary
ListingSummary --> ListingOffer
ListingSummary --> ListingKind
BrowseListingsQueryValidator ..> BrowseListingsQuery : validates
BrowseListingsQueryHandler ..> BrowseListingsQuery : handles
BrowseListingsQueryHandler ..> IAppDbContext : reads
BrowseListingsQueryHandler ..> BrowseResultDto : returns
BrowseResultDto o-- ListingSummaryDto : a page of
BrowseListingsQueryHandler ..> BrowseRadius : applies
IAppDbContext --> Listing
Listing --> ListingStatus : has
@enduml
