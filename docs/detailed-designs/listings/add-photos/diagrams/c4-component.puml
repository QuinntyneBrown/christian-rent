@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Add photos

Person(member, "Member", "Adds photos on Post")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(page, "PostPage", "Page in rent, lazy route", "Shows the photos field for a listing for rent; feeds the preview")
  Component(picker, "PhotoPicker", "Presentation component", "Thumbnails, add, remove and reorder by touch and keyboard")
  Component(uploads, "PhotoUploads", "Service in domain listings/", "At most 6 uploads; owns object URLs and AbortControllers; provided at the Post route")
  Component(client, "PhotosApi", "HTTP client in api, PHOTOS_API", "Uploads and discards a photo; builds a photo address for a size")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "PhotosController", "ASP.NET Core controller", "Upload, Discard and Get actions; each sends one MediatR request")
  Component(upload, "UploadPhotoCommandHandler", "MediatR handler", "Inspects, stores, records")
  Component(get, "GetPhotoQueryHandler", "MediatR handler", "Decides whether the caller may be served the photo")
  Component(inspector, "IPhotoInspector", "Application port", "Type by content, size, dimensions, metadata removal, sized copies")
  Component(storage, "IPhotoStorage", "Application port", "Saves, opens and deletes photo files")
  Component(entity, "Photo", "Domain entity", "The record of one photo: owner, listing, position, dimensions")
}
ContainerDb(db, "Database", "Relational, EF Core; engine <TO SUPPLY>", "Photo records")
Container(files, "File storage", "Product <TO SUPPLY>", "Photo files at each stored size")

Rel(member, page, "Adds, removes, reorders")
Rel(page, picker, "Renders the photos field with")
Rel(page, uploads, "Adds files to; reads the ordered photos from")
Rel(uploads, client, "upload(file, signal), discard(id)")
Rel(client, ctrl, "POST /photos, DELETE and GET /photos/id", "HTTPS")
Rel(ctrl, upload, "Sends UploadPhotoCommand", "MediatR")
Rel(ctrl, get, "Sends GetPhotoQuery", "MediatR")
Rel(upload, inspector, "Inspects with")
Rel(upload, storage, "Saves through")
Rel(upload, entity, "Creates")
Rel(upload, db, "Saves the record through IAppDbContext", "EF Core")
Rel(get, db, "Reads the record and its listing's status", "EF Core")
Rel(get, storage, "Opens the file through")
Rel(storage, files, "Reads and writes")
@enduml
