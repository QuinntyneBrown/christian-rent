@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Read a listing

package "Frontend — api library" {
  class ListingDetail {
    +id: string
    +offer: ListingOffer
    +kind: ListingKind
    +title: string
    +price: Price
    +when: string | null
    +area: string
    +distanceKm: number
    +postedAt: string
    +note: string | null
    +photos: PhotoRef[]
    +postedBy: PostedBy
    +church: ChurchRef
    +status: ListingStatus
    +postedByViewer: boolean
  }
  class Price {
    +amount: number
    +period: PricePeriod
  }
  class PostedBy {
    +name: string
    +memberSince: number
    +verified: boolean
  }
  class ChurchRef {
    +name: string
    +verified: boolean
  }
  class PhotoRef {
    +id: string
    +alt: string
    +width: number
    +height: number
  }
  interface ListingsApi {
    +get(id: string, place: Place, signal: AbortSignal): Promise<ListingDetail>
  }
  class ApiError {
    +code: string
  }
}
package "Frontend — rent application" {
  class ListingPage {
    +id: input<string>
    +listing: Resource<ListingDetail>
    +notFound: Signal<boolean>
  }
}
package "Backend — Application" {
  class GetListingQuery {
    +Guid Id
    +PlaceRef Place
  }
  class GetListingQueryHandler {
    +Handle(query: GetListingQuery): Task<ListingDetailDto>
  }
  class ListingDetailDto {
    +Guid Id
    +string Title
    +PriceDto Price
    +string? When
    +string Area
    +int DistanceKm
    +DateTimeOffset PostedAt
    +string? Note
    +PostedByDto PostedBy
    +ChurchRefDto Church
    +IReadOnlyList<PhotoRefDto> Photos
    +ListingStatus Status
    +bool PostedByViewer
  }
  interface ICurrentMember {
    +Guid? MemberId
    +bool IsAdmin
  }
  class ListingNotFoundException {
    +string Code = "listing_not_found"
  }
}
package "Backend — Domain" {
  class Listing {
    +Guid Id
    +Guid MemberId
    +ListingOffer Offer
    +ListingKind Kind
    +ListingStatus Status
    +string Title
    +string? When
    +string Area
    +string? Note
    +DateTimeOffset PostedAt
    +IsVisibleTo(memberId: Guid?, isAdmin: bool): bool
  }
  class Photo {
    +Guid Id
    +int Position
  }
  class Member {
    +Guid Id
    +string Name
    +DateTimeOffset JoinedAt
    +bool Verified
  }
  class Church {
    +Guid Id
    +string Name
    +bool Verified
  }
  enum ListingStatus {
    WaitingForReview
    Approved
    Removed
  }
}
ListingPage ..> ListingsApi : requests
ListingsApi ..> ListingDetail : returns
ListingsApi ..> ApiError : refuses with
ListingDetail *-- Price
ListingDetail *-- PostedBy
ListingDetail *-- ChurchRef
ListingDetail *-- "0..6" PhotoRef
GetListingQueryHandler ..> GetListingQuery : handles
GetListingQueryHandler ..> ICurrentMember : asks
GetListingQueryHandler ..> ListingDetailDto : returns
GetListingQueryHandler ..> ListingNotFoundException : throws
GetListingQueryHandler ..> Listing : loads
Listing --> ListingStatus : has
Listing "1" *-- "0..6" Photo
Listing "*" --> "1" Member : posted by
Member "*" --> "1" Church : belongs to
@enduml
