@startuml
title UML sequence behaviour — Leave christian.rent
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — rent application" #E0F2FE
  participant "Leave control (<TO SUPPLY>)" as page
end box
box "Frontend — api library" #E0F2FE
  participant "MembersApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "MembersController" as controller
  participant "Scheduled run (<TO SUPPLY>)" as job
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "LeaveCommandHandler" as leave
  participant "DeleteLeftMembersCommandHandler" as purge
  participant "Member" as entity
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
  participant "IPhotoStorage" as files
end box
actor -> page : Ask to leave
page -> client : leave()
client -> controller : DELETE /members/me
controller -> controller : Authenticate; 401 without a signed-in member (L2-025 criterion 1)
controller -> leave : Send LeaveCommand
leave -> db : Load the member and the member's listings
db --> leave : Member and listings
leave -> entity : Leave(now)
leave -> leave : Set each listing to Removed, so it and its photos are no longer public (L2-028 criterion 2)
leave -> db : Save in one unit of work
db --> leave : Commit result
leave --> controller : Done
controller --> client : 204
client --> page : Done
page --> actor : Confirm the membership is deleted
== Later, within 30 days of leaving (L2-028 criterion 2) ==
job -> purge : Send DeleteLeftMembersCommand
purge -> db : Find members whose LeftAt is set and whose data remains
db --> purge : Members who left
loop each member who left
  purge -> files : Delete the photos of the member's listings
  files --> purge : Deleted
  purge -> db : Delete the member's personal data or make it anonymous
  db --> purge : Commit result
end
purge --> job : Count of members handled
@enduml
