@startuml
title UML sequence behaviour — Open a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Anyone" as actor
box "Frontend — rent application" #E0F2FE
  participant "ListingPage" as page
  participant "ListingStore" as store
  participant "HttpListingsApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "ListingsController" as ctrl
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "GetListingQueryHandler" as handler
  participant "ListingVisibility" as vis
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> page : Open /listings/{id}
page -> store : load(id)
page --> actor : Skeleton in the shape of the listing (L2-033)
store -> client : get(id)
client -> ctrl : GET /api/listings/{id}
ctrl -> handler : Send GetListingQuery
handler -> db : Listing with member, church and photos
db --> handler : Listing or nothing
handler -> vis : CanBeSeenBy(listing, caller)
alt approved, or caller is poster or admin
  vis --> handler : true
  handler --> ctrl : ListingDetailDto, no contact detail (L2-008)
  ctrl --> client : 200 OK
  client --> store : ListingDetail
  store --> page : state = loaded
  page --> actor : Listing, poster, church, "Verified" marks where true
else missing, waiting or removed
  vis --> handler : false
  handler --> ctrl : NotFoundException
  ctrl --> client : 404 ProblemDetails, code = not_found (L2-007)
  client --> store : ApiError(not_found)
  store --> page : state = not-found
  page --> actor : "Not found" with a way back to Browse
end
@enduml
