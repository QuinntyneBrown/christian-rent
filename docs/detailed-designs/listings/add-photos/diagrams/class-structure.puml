@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Add photos

package "Frontend — components library" {
  class PhotoPicker {
    +photos: input<PhotoUpload[]>
    +canAdd: input<boolean>
    +add: output<File[]>
    +remove: output<string>
    +move: output<PhotoMove>
  }
}
package "Frontend — domain library" {
  class PhotoUploads {
    +{static} MAX_PHOTOS: 6
    +photos: Signal<PhotoUpload[]>
    +photoIds: Signal<string[]>
    +add(files: File[]): AddResult
    +remove(localId: string): void
    +move(from: number, to: number): void
    +retry(localId: string): void
    +destroy(): void
  }
  class PhotoUpload {
    +localId: string
    +thumbnailUrl: string
    +status: PhotoUploadStatus
    +photoId: string | null
    +errorCode: string | null
  }
  enum PhotoUploadStatus {
    uploading
    uploaded
    refused
    failed
  }
}
package "Frontend — api library" {
  interface PhotosApi {
    +upload(file: File, signal: AbortSignal): Promise<UploadedPhoto>
    +discard(photoId: string): Promise<void>
    +url(photoId: string, size: PhotoSize): string
  }
  class UploadedPhoto {
    +id: string
    +width: number
    +height: number
  }
  enum PhotoSize {
    thumbnail
    card
    gallery
    queueRow
    reviewDetail
  }
}
package "Backend — Application" {
  class UploadPhotoCommand {
    +Stream Content
    +long Length
  }
  class UploadPhotoCommandHandler {
    +Handle(command: UploadPhotoCommand): Task<UploadedPhotoDto>
  }
  class GetPhotoQuery {
    +Guid Id
    +PhotoSize Size
  }
  class GetPhotoQueryHandler {
    +Handle(query: GetPhotoQuery): Task<PhotoContent>
  }
  class DiscardPhotoCommand {
    +Guid Id
  }
  interface IPhotoInspector {
    +Inspect(content: Stream, length: long): PhotoInspection
  }
  class PhotoInspection {
    +bool Accepted
    +string? RefusalCode
    +int Width
    +int Height
    +IReadOnlyList<SizedPhoto> Copies
  }
  interface IPhotoStorage {
    +Save(photoId: Guid, size: PhotoSize, content: Stream): Task
    +Open(photoId: Guid, size: PhotoSize): Task<Stream>
    +Delete(photoId: Guid): Task
  }
}
package "Backend — Domain" {
  class Photo {
    +Guid Id
    +Guid MemberId
    +Guid? ListingId
    +int Position
    +int Width
    +int Height
    +DateTimeOffset UploadedAt
    +IsServedTo(memberId: Guid?, isAdmin: bool, listingStatus: ListingStatus?): bool
  }
  class PhotoLimits {
    +{static} int PerListing = 6
    +{static} long MaxBytes = 10 MB
    +{static} int MinWidth = 400
    +{static} int MinHeight = 300
    +{static} int MaxSide = 8000
  }
  class Listing {
    +Guid Id
    +ListingStatus Status
    +AttachPhotos(photos: IReadOnlyList<Photo>): void
  }
}
PhotoPicker ..> PhotoUpload : shows
PhotoUploads *-- "0..6" PhotoUpload
PhotoUpload --> PhotoUploadStatus : has
PhotoUploads ..> PhotosApi : uploads through
PhotosApi ..> UploadedPhoto : returns
PhotosApi ..> PhotoSize
UploadPhotoCommandHandler ..> UploadPhotoCommand : handles
UploadPhotoCommandHandler ..> IPhotoInspector : inspects with
UploadPhotoCommandHandler ..> IPhotoStorage : saves through
UploadPhotoCommandHandler ..> Photo : creates
IPhotoInspector ..> PhotoInspection : returns
IPhotoInspector ..> PhotoLimits : applies
GetPhotoQueryHandler ..> GetPhotoQuery : handles
GetPhotoQueryHandler ..> Photo : asks IsServedTo
GetPhotoQueryHandler ..> IPhotoStorage : opens through
Listing "1" *-- "0..6" Photo : ordered by Position
@enduml
