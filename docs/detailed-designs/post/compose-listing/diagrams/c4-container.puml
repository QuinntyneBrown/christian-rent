@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Compose a listing

Person(member, "Member", "Posts listings, sends messages and reports")
Person(person, "Person who is not a member", "Wants to post, message or report")
System_Boundary(cr, "christian.rent") {
  Container(spa, "rent application", "Angular, zoneless, lazy routes, its own origin", "Browse, Listing, Post and Sign in")
  Container(adm, "admin application", "Angular, zoneless, lazy routes, its own origin", "Admin and Admin sign-in")
  Container(api, "ChristianRent.Api", "ASP.NET Core", "Controllers, MediatR handlers and domain rules")
  ContainerDb(db, "Database", "EF Core; engine <TO SUPPLY>", "Listings, members, churches, messages, reports and the review queue")
}
Rel(member, spa, "Uses", "HTTPS")
Rel(person, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls /api/ on its origin", "JSON/HTTPS")
Rel(adm, api, "Calls /api/admin/ on its origin", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
