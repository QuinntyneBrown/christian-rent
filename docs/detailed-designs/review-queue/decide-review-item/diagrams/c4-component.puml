@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Decide a review item

Person(admin, "Admin", "Decides each item of the review queue")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(panel, "ReviewDetailPanel", "Component in admin", "Action bar: Approve or Keep listing, and Remove")
  Component(page, "AdminPage", "Page in admin", "Opens the confirmation, sends the decision")
  Component(dialog, "ConfirmRemoveDialog", "CDK Dialog in admin", "Asks the admin to confirm Remove")
  Component(store, "ReviewQueueStore", "Service in admin", "Drops a decided item and selects the one that takes its place")
  Component(client, "ReviewQueueApi", "Contract and HTTP client in api", "decide")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "ReviewQueueController", "ASP.NET Core controller", "Admin policy; sends DecideReviewItemCommand")
  Component(handler, "DecideReviewItemCommandHandler", "MediatR handler", "Applies the outcome to the item and its subject")
  Component(item, "ReviewItem", "Domain entity", "Outcomes allowed per kind; decided once; gathers the open reports on a listing")
  Component(decision, "ReviewDecision", "Domain entity", "Who decided, on what, when, with which outcome")
  Component(listing, "Listing", "Domain entity", "Approve(), Remove()")
  Component(member, "Member", "Domain entity", "Verify(), Remove()")
  Component(current, "ICurrentMember", "Application port", "The deciding admin")
  Component(clock, "TimeProvider", "Application port", "The time of the decision")
}
ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Review items, decisions, listings, members")

Rel(admin, panel, "Selects Approve, Keep listing or Remove in")
Rel(panel, page, "Emits the decision to")
Rel(page, dialog, "Opens for Remove")
Rel(page, client, "Sends through REVIEW_QUEUE_API")
Rel(page, store, "Removes the decided item from")
Rel(client, ctrl, "POST /review-queue/{id}/decision", "JSON/HTTPS")
Rel(ctrl, handler, "Sends DecideReviewItemCommand", "MediatR")
Rel(handler, current, "Reads the admin from")
Rel(handler, clock, "Reads the time from")
Rel(handler, item, "Decides")
Rel(item, decision, "Produces")
Rel(handler, listing, "Approves or removes")
Rel(handler, member, "Verifies or removes")
Rel(handler, db, "Saves through IAppDbContext", "EF Core")
@enduml
