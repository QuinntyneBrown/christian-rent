@startuml
title UML sequence behaviour — Report a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — rent application" #E0F2FE
  participant "ListingPage" as page
  participant "ReportDialog" as dialog
end box
box "Frontend — domain library" #E0F2FE
  participant "ReportRules" as rules
end box
box "Frontend — api library" #E0F2FE
  participant "ReportsApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "ReportsController" as controller
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "ReportListingCommandValidator" as validator
  participant "ReportListingCommandHandler" as handler
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> page : Select Report, the flag icon beside Share (L2-021 criterion 6)
alt the person is not a member (L2-021 criterion 5)
  page --> actor : Ask to become a member or sign in (<TO SUPPLY>)
else the person is a member
  page -> dialog : Import and open
  actor -> dialog : Choose one of the four reasons, add a note if wanted (L2-021 criterion 1)
  dialog -> rules : check(request)
  rules --> dialog : Field errors, or none
  alt no reason, or a note over 500 characters
    dialog --> actor : Mark the field with its reason
  else the entry is valid
    dialog -> client : report(listingId, request)
    client -> controller : POST /listings/{listingId}/reports
    controller -> controller : Authenticate; 401 without a signed-in member (L2-025 criterion 1)
    controller -> validator : Send ReportListingCommand
    validator -> validator : Apply L2-021 criterion 1 again
    validator -> handler : Valid command
    handler -> db : Load the listing, this member's report on it and the listing's open review item
    db --> handler : Listing, the earlier report if any, the open item if any
    alt the listing is not approved, was removed or does not exist
      handler --> controller : listing_not_found
    else this member already reported it (L2-021 criterion 3)
      handler --> controller : Success; no second report is created
    else first report
      opt the listing has no open review item of kind Report
        handler -> handler : Create ReviewItem of kind Report (L2-021 criterion 2)
      end
      handler -> handler : Create Report with listing, review item, reporter, reason and note
      handler -> db : Save in one unit of work; the listing stays one item (L2-020 criterion 8)
      db --> handler : Commit result
      handler --> controller : Success
    end
    controller --> client : 204, or ProblemDetails with a code
    client --> dialog : Done, or ApiError
    alt done
      dialog --> actor : A confirmation (L2-021 criterion 2)
    else refused or failed
      dialog --> actor : Keep the reason and note, show a generic message and "Try again"
    end
  end
end
note over controller, db
  No response to anyone carries the reporter: not to the member who posted
  the listing, and not to an admin (L2-021 criterion 4, L2-019 criterion 2).
  The admin sees the number of reports and what the report says.
end note
@enduml
