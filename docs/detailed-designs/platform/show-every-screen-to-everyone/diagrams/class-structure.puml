@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show every screen to everyone

enum Breakpoint {
  sm = 640
  md = 768
  lg = 1024
  xl = 1280
}

interface Viewport <<api contract, VIEWPORT>> {
  +atLeast(breakpoint: Breakpoint): Signal<boolean>
  +reducedMotion: Signal<boolean>
}

class MatchMediaViewport <<rent>> {
  -queries: Map<Breakpoint, MediaQueryList>
  +atLeast(breakpoint: Breakpoint): Signal<boolean>
  +reducedMotion: Signal<boolean>
}

interface Announcer <<api contract, ANNOUNCER>> {
  +announce(text: string, politeness: 'polite' | 'assertive'): void
}

class CdkAnnouncer <<rent>> {
  +announce(text: string, politeness: 'polite' | 'assertive'): void
}

class RouteFocus <<rent service>> {
  +focusHeading(): void
}

class AppShell <<cr-shell>> {
  +showsHeader: Signal<boolean>
  +unreadCount: Signal<number>
  +initials: Signal<string>
}

class Header <<cr-header>> {
  +unreadCount: input<number>
  +initials: input<string>
  +home: output<void>
  +openMessages: output<void>
  +openAccount: output<void>
  +post: output<void>
}

class Wordmark <<cr-wordmark>> {
}

interface MessagesApi <<api contract, MESSAGES_API>> {
}

class FormField <<cr-form-field>> {
  +label: input<string>
  +error: input<string | null>
  +hint: input<string | null>
}

class "Foundations" as Foundations <<SCSS partials>> {
  _breakpoints.scss: from($breakpoint)
  _tokens.scss: colour, type, space by role
  _reset.scss: :focus-visible ring
  _targets.scss: target($min: 44px)
  _page.scss: page(), 1152 px, margins 16 and 24 px
  _motion.scss: 120 to 300 ms; none under reduced motion
  _utilities.scss: visually-hidden
}

class AdminPage <<admin library>> {
  +showsDetailPanel: Signal<boolean>
}

Viewport ..> Breakpoint : takes
MatchMediaViewport ..|> Viewport
CdkAnnouncer ..|> Announcer
AppShell ..> RouteFocus : calls after navigation
AppShell *-- Header : shows on Browse and Listing
Header *-- Wordmark : holds in the home control
AppShell ..> MessagesApi : reads the number unread through
Header ..> Foundations : reads tokens and mixins
AdminPage ..> Viewport : reads atLeast(md)
FormField ..> Foundations : reads tokens and mixins
AppShell ..> Foundations : loads through styles.scss
Foundations ..> Breakpoint : holds the same four widths
@enduml
