@startuml
title UML sequence behaviour — Select an item
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Admin" as actor
box "Frontend — admin application (review page, lazy)" #E0F2FE
  participant "ReviewPage" as page
  participant "ReviewQueueStore" as store
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "ReviewQueueController" as ctrl
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "GetReviewItemQueryHandler" as handler
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> page : Select a queue row
page -> store : select(id)
store -> store : Abort the previous detail request
store -> ctrl : GET /api/admin/review-queue/{id}
ctrl -> handler : Send GetReviewItemQuery
handler -> db : Review item and its subject
db --> handler : Item with listing, report or member
handler --> ctrl : ReviewItemDetailDto, one part by kind
ctrl --> store : 200 OK
store --> page : detail
page --> actor : Detail panel: fields, photos, poster; or reason; or name and church
@enduml
