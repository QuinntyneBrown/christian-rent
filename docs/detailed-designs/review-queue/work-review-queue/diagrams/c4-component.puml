@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Work through the review queue

Person(admin, "Admin", "Works through the review queue")
Container_Boundary(rent, "rent (Angular application and its libraries)") {
  Component(guard, "adminCanMatch", "Route guard in rent", "Lets the admin route match, and its code load, only for an admin")
  Component(page, "AdminPage", "Page in admin", "Orchestrates the queue and the selected item; heading Review and the summary line")
  Component(nav, "AdminNav", "Component in admin", "Review, Reports, Members, Churches; a column from 768 px, a top bar under it")
  Component(store, "ReviewQueueStore", "Service in admin, provided at the Admin route", "Pages of 50, a bounded window, the selected item, the summary")
  Component(list, "ReviewQueueList", "Component in admin", "Items newest first, each labelled New, Reported or New member")
  Component(panel, "ReviewDetailPanel", "Component in admin", "One layout for every kind: report banner, photos, title, price, note, who posted, View on site")
  Component(empty, "EmptyState", "Presentation component in components", "All caught up")
  Component(client, "ReviewQueueApi", "Contract and HTTP client in api", "list, get, summary")
}
Container_Boundary(api, "ChristianRent.Api") {
  Component(ctrl, "ReviewQueueController", "ASP.NET Core controller", "Admin policy; sends one query per action")
  Component(queue, "GetReviewQueueQueryHandler", "MediatR handler", "One page of open items, newest first")
  Component(item, "GetReviewItemQueryHandler", "MediatR handler", "The detail of one item; the report count and words, never the reporter")
  Component(summary, "GetReviewQueueSummaryQueryHandler", "MediatR handler", "Number waiting, median wait, number approved this week")
  Component(entity, "ReviewItem", "Domain entity", "Kind, listing or member, created time, decided time")
}
ContainerDb(db, "Database", "Relational, engine <TO SUPPLY>", "Review items, listings, reports, members, churches")

Rel(admin, guard, "Opens Admin's address through")
Rel(guard, page, "Loads the admin library and shows")
Rel(page, store, "Reads state from")
Rel(page, nav, "Binds")
Rel(page, list, "Binds")
Rel(page, panel, "Binds, from 768 px")
Rel(page, empty, "Shows when the queue is empty")
Rel(store, client, "Loads through REVIEW_QUEUE_API")
Rel(client, ctrl, "GET /review-queue, /review-queue/{id}, /review-queue/summary", "JSON/HTTPS")
Rel(ctrl, queue, "Sends GetReviewQueueQuery", "MediatR")
Rel(ctrl, item, "Sends GetReviewItemQuery", "MediatR")
Rel(ctrl, summary, "Sends GetReviewQueueSummaryQuery", "MediatR")
Rel(summary, db, "Reads through IAppDbContext", "EF Core")
Rel(queue, entity, "Reads")
Rel(item, entity, "Reads")
Rel(queue, db, "Reads through IAppDbContext", "EF Core")
Rel(item, db, "Reads through IAppDbContext", "EF Core")
@enduml
