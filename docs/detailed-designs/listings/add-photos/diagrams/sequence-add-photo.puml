@startuml
title UML sequence behaviour — Add a photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — rent application" #E0F2FE
  participant "PostPage" as page
end box
box "Frontend — domain library" #E0F2FE
  participant "PhotoUploads" as uploads
end box
box "Frontend — api library" #E0F2FE
  participant "PhotosApi" as client
end box
box "Backend — ChristianRent.Api" #D1FADF
  participant "PhotosController" as controller
end box
box "Backend — ChristianRent.Application and Domain" #ECFDF3
  participant "UploadPhotoCommandHandler" as handler
  participant "IPhotoInspector" as inspector
end box
box "Backend — ChristianRent.Infrastructure" #FFF4E5
  participant "IPhotoStorage" as storage
  database "Database" as db
end box
actor -> page : Select the "Add" tile in PhotoPicker (L2-013 criterion 6)
page -> uploads : add(files)
alt 6 photos are already added
  uploads --> page : Refused
  page --> actor : Message that 6 is the most (L2-013 criterion 3)
else fewer than 6
  uploads -> uploads : Create an object URL for the thumbnail\nand an AbortController
  uploads --> page : photos, one uploading
  page --> actor : Thumbnail; the preview card shows the first photo\n(L2-013 criterion 1)
  uploads -> client : upload(file, signal)
  client -> controller : POST /photos, multipart
  controller -> controller : Authenticate; refuse a body above 10 MB
  controller -> handler : Send UploadPhotoCommand
  handler -> inspector : Inspect(content, length)
  alt not a JPEG, PNG or WebP by content
    inspector --> handler : Refused (L2-014 criterion 1)
    handler --> controller : code photo_not_an_image
  else above 10 MB, under 400 x 300 px, or a side above 8,000 px
    inspector --> handler : Refused (L2-014 criterion 2)
    handler --> controller : code photo_too_large, photo_too_small\nor photo_dimensions_too_large, with the limit
  else accepted
    inspector --> handler : Copies at each size, re-encoded without location data\nor other metadata (L2-014 criterion 3)
    handler -> storage : Save each copy
    storage --> handler : Saved
    handler -> db : Save the Photo record, owned by the member,\nnot yet on a listing
    db --> handler : Commit result
    handler --> controller : UploadedPhotoDto
  end
  controller --> client : 201 Created, or ProblemDetails
  client --> uploads : UploadedPhoto, or ApiError
  uploads --> page : photos: uploaded, or refused with its code
  page --> actor : Thumbnail kept, or a message naming the limit
end
opt the member removes or reorders a photo
  actor -> page : Select "Remove photo", or move earlier or later
  page -> uploads : remove(localId) or move(from, to)
  uploads -> uploads : Revoke the object URL of a removed photo
  uploads -> client : discard(photoId) for a removed, uploaded photo
  uploads --> page : photos in the new order
  page --> actor : The preview card follows (L2-013 criterion 2)
end
opt the member switches "have" to "need" and back
  page -> page : Remove the photos field; send no photo id\nfor a wanted listing (L2-009 criterion 1)
  page --> actor : On "have" again, the same photos (L2-013 criterion 7)
end
opt the member leaves Post while a photo is uploading
  page -> uploads : destroy()
  uploads -> client : Abort every upload in flight (L2-013 criterion 5)
  uploads -> uploads : Revoke every object URL
  uploads -> client : discard(photoId) for each uploaded photo not posted
end
@enduml
